PROJECT_NAME="Hospital AI Platform"
ENV=dev
API_V1_STR="/api/v1"
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=NewStrongPassword123!
POSTGRES_DB=hospital_ai
POSTGRES_PORT=5432
JWT_SECRET=dev-secret-key
