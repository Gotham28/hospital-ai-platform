# 4173 is `vite preview` (the production-style build server), needed to test
# voice/VAD locally: the Vite dev server (5173) cannot load the VAD WASM
# assets, so voice must be verified against a preview build instead.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173
