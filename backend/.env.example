PROJECT_NAME="Hospital AI Platform"
ENV=dev
API_V1_STR="/api/v1"
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=NewStrongPassword123!
POSTGRES_DB=hospital_ai
POSTGRES_PORT=5432
JWT_SECRET=dev-secret-key
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
SARVAM_API_KEY=
# Read directly from this .env file via pydantic-settings (Settings.ALLOWED_ORIGINS)
# — no need to export it in the shell. Comma-separated list of allowed CORS origins.
# 4173 is `vite preview` (the production-style build server), needed to test
# voice/VAD locally: the Vite dev server (5173) cannot load the VAD WASM
# assets, so voice must be verified against a preview build instead.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173

# Meta Cloud API welcome messages. Keep disabled until setup and test acceptance.
META_WHATSAPP_ENABLED=false
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_TEMPLATE_EN=
META_WHATSAPP_TEMPLATE_ML=
# Exact approved BODY text: {{1}} = hospital name, {{2}} = full assistant URL.
META_WHATSAPP_TEMPLATE_BODY_EN=
META_WHATSAPP_TEMPLATE_BODY_ML=
META_WHATSAPP_LANGUAGE_EN=en_US
META_WHATSAPP_LANGUAGE_ML=ml
PUBLIC_PATIENT_BASE_URL=
META_WHATSAPP_ENABLED_HOSPITAL_SLUGS=
# Separate random secret, at least 32 characters. Never reuse JWT or Meta secrets.
WHATSAPP_RECIPIENT_HASH_SECRET=
