import React, { useEffect, useState } from 'react';
import api from '../api/axios';

const UsageStats = () => {
  const [stats, setStats] = useState({ total_tokens: 0, estimated_cost: 0 });

  useEffect(() => {
    // We'll need to create this GET /usage/summary endpoint next
