<file path="frontend/src/themes/arogya-specialty/Chat.tsx">
import React, { useState, useEffect, useRef, useCallback } from 'react';
import SpeechRecognition, { useSpeechRecognition } from 'react-speech-recognition';
import ChatMessage from './ChatMessage';
import { Mic, MicOff, Loader2, Activity, Send, Zap, X } from 'lucide-react';

interface ChatProps { hospitalId: string; }

interface Message {
  role: 'user' | 'assistant';
  content: string;
  isWelcome?: boolean;
  isStreaming?: boolean;
}

const SUGGESTIONS = {
  'en-US': ["Who is the cardiologist today?", "Where is the pharmacy?", "Visiting hours?", "Emergency contact"],
  'ml-IN': ["കാർഡിയോളജിസ്റ്റ് ആരാണ്?", "ഫാർമസി എവിടെയാണ്?", "സന്ദർശന സമയം?", "അടിയന്തര നമ്പർ"]
};

// Silence duration in ms after which recording stops automatically.
// 3 seconds gives Malayalam speakers enough time between words without
// keeping the mic open indefinitely.
const SILENCE_TIMEOUT_MS = 3000;

function buildHistory(messages: Message[]): { role: string; content: string }[] {
  return messages
    .filter(m => !m.isWelcome && !m.isStreaming)
    .map(m => ({ role: m.role, content: m.content }));
}

function getBaseURL(): string {
  return window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
    ? 'http://localhost:8000/api/v1'
    : 'https://hospital-ai-platform.onrender.com/api/v1';
}

const Chat: React.FC<ChatProps> = ({ hospitalId }) => {
  const [language, setLanguage] = useState<'en-US' | 'ml-IN'>('ml-IN');
  const [messages, setMessages] = useState<Message[]>([]);
  const [isStreaming, setIsStreaming] = useState(false);
  const [inputText, setInputText] = useState('');
  const scrollRef = useRef<HTMLDivElement>(null);
  const abortRef = useRef<AbortController | null>(null);

  // silenceTimer fires after SILENCE_TIMEOUT_MS of no new transcript words.
  // It only stops the mic — it does NOT send. The user sends manually.
  const silenceTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  // Track the last transcript we saw so we can detect when new words arrive.
  const lastTranscriptRef = useRef('');

  const {
    transcript,
    listening,
    resetTranscript,
    browserSupportsSpeechRecognition,
  } = useSpeechRecognition();

  // ── SEND ────────────────────────────────────────────────────────────────────

  const handleSend = useCallback(async (textOverride?: string) => {
    const text = (textOverride ?? inputText).trim();
    if (!text || isStreaming) return;

    // Stop mic if still running
    if (listening) {
      SpeechRecognition.stopListening();
      if (silenceTimer.current) clearTimeout(silenceTimer.current);
    }

    // Cancel any in-flight stream
    abortRef.current?.abort();
    abortRef.current = new AbortController();

    const historySnapshot = buildHistory(messages);
    setInputText('');
    resetTranscript();
    lastTranscriptRef.current = '';

    setMessages(prev => [...prev, { role: 'user', content: text }]);
    setMessages(prev => [...prev, { role: 'assistant', content: '', isStreaming: true }]);
    setIsStreaming(true);

    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`${getBaseURL()}/ai/chat-stream`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify({
          question: text,
          hospital_id: parseInt(hospitalId),
          language: language === 'ml-IN' ? 'ml' : 'en',
          history: historySnapshot,
        }),
        signal: abortRef.current.signal,
      });

      if (!response.ok || !response.body) throw new Error(`HTTP ${response.status}`);

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const frames = buffer.split('\n\n');
        buffer = frames.pop() ?? '';

        for (const frame of frames) {
          if (!frame.startsWith('data: ')) continue;
          const payload = frame.slice(6);

          if (payload === '[DONE]') {
            setMessages(prev =>
              prev.map((m, i) => i === prev.length - 1 ? { ...m, isStreaming: false } : m)
            );
            break;
          }

          if (payload.startsWith('[ERROR]')) {
            setMessages(prev =>
              prev.map((m, i) =>
                i === prev.length - 1
                  ? { ...m, content: 'Sorry, something went wrong. Please try again.', isStreaming: false }
                  : m
              )
            );
            break;
          }

          try {
            const tokenText = JSON.parse(payload);
            setMessages(prev =>
              prev.map((m, i) =>
                i === prev.length - 1 ? { ...m, content: m.content + tokenText } : m
              )
            );
          } catch { /* skip malformed token */ }
        }
      }
    } catch (err: unknown) {
      if (err instanceof Error && err.name === 'AbortError') return;
      setMessages(prev =>
        prev.map((m, i) =>
          i === prev.length - 1
            ? { ...m, content: 'Error connecting to Arogya. Please try again.', isStreaming: false }
            : m
        )
      );
    } finally {
      setIsStreaming(false);
    }
  }, [inputText, messages, isStreaming, hospitalId, language]);

  // ── MIC TOGGLE ──────────────────────────────────────────────────────────────

  const startListening = useCallback(() => {
    resetTranscript();
    lastTranscriptRef.current = '';
    SpeechRecognition.startListening({ continuous: true, language });
  }, [language, resetTranscript]);

  const stopListening = useCallback(() => {
    SpeechRecognition.stopListening();
    if (silenceTimer.current) {
      clearTimeout(silenceTimer.current);
      silenceTimer.current = null;
    }
    // Do NOT send here — the transcript stays in the input for the user to review.
  }, []);

  const toggleMic = useCallback(() => {
    if (listening) {
      stopListening();
    } else {
      startListening();
    }
  }, [listening, startListening, stopListening]);

  // Discard the current voice transcript without sending.
  const cancelVoice = useCallback(() => {
    stopListening();
    resetTranscript();
    lastTranscriptRef.current = '';
    setInputText('');
  }, [stopListening, resetTranscript]);

  // ── VOICE → INPUT SYNC ──────────────────────────────────────────────────────
  //
  // KEY DESIGN DECISION:
  // Instead of auto-sending on silence, we flow the transcript into the
  // text input in real time. The user sees exactly what was heard and can
  // edit or send at their own pace.
  //
  // The silence timer only STOPS THE MIC — it never calls handleSend.
  // This eliminates the race condition entirely.

  useEffect(() => {
    if (!listening) return;

    // New words arrived — update the input field
    if (transcript !== lastTranscriptRef.current) {
      lastTranscriptRef.current = transcript;
      setInputText(transcript);

      // Reset the silence timer every time new words arrive.
      // If no new words arrive within SILENCE_TIMEOUT_MS, stop the mic
      // (but keep the transcript in the input — don't discard it).
      if (silenceTimer.current) clearTimeout(silenceTimer.current);
      silenceTimer.current = setTimeout(() => {
        if (listening) {
          stopListening();
          // The transcript is already in inputText — user can see it and edit.
        }
      }, SILENCE_TIMEOUT_MS);
    }
  }, [transcript, listening, stopListening]);

  // Clean up timer if the component unmounts while recording
  useEffect(() => {
    return () => {
      if (silenceTimer.current) clearTimeout(silenceTimer.current);
    };
  }, []);

  // ── LANGUAGE SWITCH ─────────────────────────────────────────────────────────

  useEffect(() => {
    // Stop any recording when language changes
    if (listening) stopListening();
    resetTranscript();
    setInputText('');
    lastTranscriptRef.current = '';

    const welcome = language === 'ml-IN'
      ? "👋 നമസ്കാരം! ഞാൻ **ആരോഗ്യ**. എനിക്ക് എങ്ങനെ സഹായിക്കാനാകും?"
      : "👋 Hello! I am **Arogya**. How can I help you today?";
    setMessages([{ role: 'assistant', content: welcome, isWelcome: true }]);
  }, [language]);

  // ── SCROLL ──────────────────────────────────────────────────────────────────

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  if (!browserSupportsSpeechRecognition) {
    return (
      <div className="p-4 text-center text-red-500 bg-red-50 rounded-xl">
        Voice input is not supported in this browser. Please use Chrome or Edge.
      </div>
    );
  }

  // ── RENDER ──────────────────────────────────────────────────────────────────

  // Whether we are in "voice mode" — mic is active or there's a pending
  // voice transcript in the input that hasn't been sent yet.
  const isVoiceMode = listening || (inputText.length > 0 && lastTranscriptRef.current === inputText);

  return (
    <div className="w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col h-[650px]">

      {/* Header */}
      <div className="bg-emerald-600 p-4 text-white shrink-0 shadow-md">
        <div className="flex justify-between items-center">
          <h3 className="font-bold flex items-center gap-2">
            <Activity className="w-4 h-4" /> Ask Arogya
          </h3>
          <button
            onClick={() => setLanguage(l => l === 'en-US' ? 'ml-IN' : 'en-US')}
            disabled={isStreaming}
            className="bg-emerald-700 px-3 py-1 rounded-md text-xs font-bold border border-white/20 disabled:opacity-50"
          >
            {language === 'en-US' ? 'English' : 'മലയാളം'}
          </button>
        </div>
      </div>

      {/* Chat area */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50">
        {messages.map((msg, idx) => (
          <ChatMessage
            key={idx}
            role={msg.role}
            content={msg.content}
            isStreaming={msg.isStreaming}
          />
        ))}

        {isStreaming && messages[messages.length - 1]?.content === '' && (
          <div className="flex items-center gap-2 text-emerald-600 p-2 bg-white rounded-lg w-fit shadow-sm border border-slate-100">
            <Loader2 className="w-4 h-4 animate-spin" />
            <span className="text-[10px] font-bold">Arogya is thinking...</span>
          </div>
        )}

        <div ref={scrollRef} />
      </div>

      {/* Suggestions */}
      <div className="px-4 py-2 bg-slate-50 border-t border-slate-100">
        <div className="flex gap-2 overflow-x-auto pb-1" style={{ scrollbarWidth: 'none' }}>
          {SUGGESTIONS[language].map((text, i) => (
            <button
              key={i}
              disabled={isStreaming}
              onClick={() => handleSend(text)}
              className="flex-none bg-white border border-emerald-100 text-emerald-700 text-[11px] px-3 py-1.5 rounded-full shadow-sm hover:bg-emerald-50 active:scale-95 transition-all disabled:opacity-40 whitespace-nowrap"
            >
              <Zap className="w-3 h-3 text-amber-400 fill-amber-400 inline mr-1" />{text}
            </button>
          ))}
        </div>
      </div>

      {/* Input + mic */}
      <div className="p-4 border-t bg-white shrink-0 space-y-3">

        {/* Text input row */}
        <div className="flex items-center gap-2">
          <div className="relative flex-1">
            <input
              type="text"
              value={inputText}
              onChange={e => {
                setInputText(e.target.value);
                // If the user edits the input manually while in voice mode,
                // detach it from the transcript tracking so the next
                // speech update doesn't overwrite their edit.
                if (lastTranscriptRef.current) {
                  lastTranscriptRef.current = '';
                }
              }}
              onKeyDown={e => {
                if (e.key === 'Enter' && !isStreaming) handleSend();
              }}
              placeholder={
                listening
                  ? (language === 'en-US' ? 'Listening...' : 'കേൾക്കുന്നു...')
                  : (language === 'en-US' ? 'Ask anything...' : 'ചോദിക്കൂ...')
              }
              disabled={isStreaming}
              className={`w-full rounded-full px-4 py-2 text-sm outline-none transition-all ${
                listening
                  ? 'bg-emerald-50 border-2 border-emerald-400 focus:ring-0 pr-8'
                  : 'bg-slate-100 border-2 border-transparent focus:border-emerald-400'
              } disabled:opacity-60`}
            />
            {/* Inline cancel button — appears when there is a voice transcript
                pending in the input so the user can discard it cleanly */}
            {isVoiceMode && inputText.length > 0 && (
              <button
                onClick={cancelVoice}
                className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-500 transition-colors"
                title="Discard voice input"
              >
                <X className="w-4 h-4" />
              </button>
            )}
          </div>
          <button
            onClick={() => handleSend()}
            disabled={isStreaming || !inputText.trim()}
            className="p-2 bg-emerald-600 text-white rounded-full hover:bg-emerald-700 transition-colors shadow-sm disabled:opacity-40"
          >
            <Send className="w-4 h-4" />
          </button>
        </div>

        {/* Mic section */}
        <div className="flex flex-col items-center gap-1">
          <button
            type="button"
            onClick={toggleMic}
            disabled={isStreaming}
            className={`p-4 rounded-full transition-all transform active:scale-90 shadow-lg disabled:opacity-40 ${
              listening
                ? 'bg-red-500 text-white ring-4 ring-red-100'
                : 'bg-emerald-50 text-emerald-600 hover:bg-emerald-100'
            }`}
          >
            {listening ? <MicOff className="w-6 h-6" /> : <Mic className="w-6 h-6" />}
          </button>

          <p className="text-[9px] uppercase tracking-widest text-slate-400 font-black">
            {listening
              ? (language === 'en-US' ? 'Tap to stop' : 'നിർത്താൻ ടാപ്പ് ചെയ്യൂ')
              : (language === 'en-US' ? 'Tap to speak' : 'സംസാരിക്കുക')}
          </p>

          {/* Guidance note — shown while mic is active so the user understands
              the new flow: voice fills input, they send manually */}
          {listening && (
            <p className="text-[10px] text-emerald-600 text-center leading-tight px-4">
              {language === 'en-US'
                ? 'Speak now. Your words appear above — edit if needed, then press Send.'
                : 'സംസാരിക്കൂ. മുകളിൽ കാണുന്ന വാക്കുകൾ ആവശ്യമെങ്കിൽ തിരുത്തി Send അമർത്തൂ.'}
            </p>
          )}
        </div>
      </div>
    </div>
  );
};

export default Chat;
