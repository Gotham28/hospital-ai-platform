from typing import Any
from sqlalchemy.ext.declarative import as_declarative, declared_attr

@as_declarative()
class Base:
    id: Any
    __name__: str

    # Generate __tablename__ automatically from class name
    # e.g., 'User' model -> 'user' table
    @declared_attr
    def __tablename__(cls) -> str:
