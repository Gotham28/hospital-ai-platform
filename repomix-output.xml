):
    """Fetch the staff directory for a specific hospital."""
    doctors = db.query(Doctor).filter(Doctor.hospital_id == hospital_id).all()
    
    # Return a formatted dict, leaving behind the 'embedding' column
    return [
        {
            "id": d.id,
            "doctor_id": d.doctor_id,
