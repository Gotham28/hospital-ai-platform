{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git add -A:*)",
      "Bash(git add -u:*)",
      "Bash(git add .)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(alembic stamp:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(pg_restore:*)",
      "PowerShell",
      "Agent(gsd-*)"
    ]
  },
  "skillOverrides": {
    "gsd-autonomous": "user-invocable-only",
    "gsd-ship": "user-invocable-only",
    "gsd-execute-phase": "user-invocable-only",
    "gsd-pr-branch": "user-invocable-only",
    "gsd-undo": "user-invocable-only",
    "gsd-cleanup": "user-invocable-only",
    "gsd-complete-milestone": "user-invocable-only",
    "gsd-code-review": "user-invocable-only",
    "gsd-review": "user-invocable-only",
    "gsd-fast": "user-invocable-only",
    "gsd-quick": "user-invocable-only"
  }
}